# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# npm's content-addressable store. amplify.yml points npm_config_cache here so
# Amplify can cache it (monorepo cache.paths resolve relative to appRoot, so a
# $HOME path is not reliably captured). Running that install line locally creates
# this directory too.
/.npm-cache/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prettier
.prettierignore
.prettierrc

# design-sync (claude.ai/design)
# Staged converter scripts + generated bundle — regenerated on every sync.
/.ds-sync/
/ds-bundle/
# Machine state: verdicts, generated previews, subagent scratch, fork symlink.
# Everything else under .design-sync/ (config.json, NOTES.md, conventions.md,
# previews/, overrides/) IS committed — those are the durable sync inputs.
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules
